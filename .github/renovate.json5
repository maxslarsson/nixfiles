{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "automerge": true,
  "platformAutomerge": true,
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["* 0-3 * * *"]
    }
  }
}
